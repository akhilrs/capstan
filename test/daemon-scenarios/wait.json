              "role": "Developer",
              "seatId": "seat-dev1"
            }
          ],
          "as": "dev1"
        },
        {
          "op": "registerAgent",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "agentId": "dev-1",
              "roleName": "developer",
              "seatId": "seat-dev1",
              "actorId": "$dev1.actorId"
            }
          ],
          "as": "agent_dev1"
        },
        {
          "op": "createSeat",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "seatId": "seat-pm",
              "name": "seat-pm",
              "role": "PM"
            }
          ]
        },
        {
          "op": "createActor",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "displayName": "PM 1",
              "role": "PM",
              "seatId": "seat-pm"
            }
          ],
          "as": "pm"
        },
        {
          "op": "registerAgent",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "agentId": "pm-1",
              "roleName": "pm",
              "seatId": "seat-pm",
              "actorId": "$pm.actorId"
            }
          ],
          "as": "agent_pm"
        },
        {
          "op": "enqueueMessage",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "recipientAgentId": "dev-1",
              "body": "waiting for you"
            }
          ],
          "as": "m1"
        },
        {
          "op": "enqueueMessage",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "recipientAgentId": "dev-1",
              "body": "needs action",
              "actionNeeded": true
            }
          ],
          "as": "m2"
        }
      ],
      "requests": [
        {
          "as": "agent:dev-1",
          "command": "wait",
          "label": "mail is already queued: the wait answers at once",
          "dump": true
        },
        {
          "as": "agent:dev-1",
          "command": "inbox",
          "label": "the mail was delivered by the wait"
        },
        {
          "as": "agent:dev-1",
          "command": "status",
          "label": "an agent's status after a wait"
        }
      ]
    },
