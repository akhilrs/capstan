{
  "scenarios": [
    {
      "name": "wait-refusals",
      "setup": [
        {
          "op": "syncRoleDefinitions",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            [
              {
                "name": "developer",
                "kind": "Developer",
                "host": "claude",
                "configHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              },
              {
                "name": "pm",
                "kind": "PM",
                "host": "claude",
                "configHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
              }
            ]
          ]
        },
        {
          "op": "createSeat",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "seatId": "seat-dev1",
              "name": "seat-dev1",
              "role": "Developer"
            }
          ]
        },
        {
          "op": "createActor",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "displayName": "Dev 1",
              "role": "Developer",
              "seatId": "seat-dev1"
            }
          ],
          "as": "dev1"
        },
        {
          "op": "registerAgent",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "agentId": "dev-1",
              "roleName": "developer",
              "seatId": "seat-dev1",
              "actorId": "$dev1.actorId"
            }
          ],
          "as": "agent_dev1"
        },
        {
          "op": "createSeat",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "seatId": "seat-pm",
              "name": "seat-pm",
              "role": "PM"
            }
          ]
        },
        {
          "op": "createActor",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "displayName": "PM 1",
              "role": "PM",
              "seatId": "seat-pm"
            }
          ],
          "as": "pm"
        },
        {
          "op": "registerAgent",
          "context": {
            "credential": "$owner.credential"
          },
          "args": [
            {
              "agentId": "pm-1",
              "roleName": "pm",
              "seatId": "seat-pm",
              "actorId": "$pm.actorId"
            }
          ],
          "as": "agent_pm"
        }
      ],
      "requests": [
        {
          "as": "operator",
          "command": "wait",
          "label": "the operator cannot wait"
        },
        {
          "as": "agent:dev-1",
          "command": "wait",
          "args": ["x"],
          "label": "wait takes no arguments"
        },
        {
          "as": "agent:pm-1",
          "command": "wait",
          "args": ["--now"],
          "label": "the PM passes an argument"
        }
      ]
    },
