      ],
      "requests": [
        {
          "as": "none",
          "label": "no token",
          "frame": "{\"action\":\"status\"}"
        },
        {
          "as": "none",
          "label": "a wrong token",
          "frame": "{\"action\":\"status\",\"token\":\"nope\"}"
        },
        {
          "as": "operator",
          "label": "status",
          "frame": {
            "json": {
              "action": "status",
              "token": "$credential"
            }
          }
        },
        {
          "as": "operator",
          "label": "inspect of an unknown id",
          "frame": {
            "json": {
              "action": "inspect",
              "id": "nothing",
              "token": "$credential"
            }
          }
        },
        {
          "as": "operator",
          "label": "inspect without an id",
          "frame": {
            "json": {
              "action": "inspect",
              "token": "$credential"
            }
          }
        },
        {
          "as": "operator",
          "label": "an unknown action",
          "frame": {
            "json": {
              "action": "restart",
              "token": "$credential"
            }
          }
        },
        {
          "as": "operator",
          "label": "a long action name is cut in the log",
          "frame": {
            "json": {
              "action": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
              "token": "$credential"
            }
          }
        }
      ]
