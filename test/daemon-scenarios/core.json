          "label": "a stub route answers not_implemented"
        },
        {
          "as": "operator",
          "command": "assign",
          "args": ["a", "b"],
          "label": "with arguments"
        },
        {
          "as": "agent:dev-1",
          "command": "ask",
          "args": ["question"],
          "label": "an agent's stub route"
        }
      ]
    },
