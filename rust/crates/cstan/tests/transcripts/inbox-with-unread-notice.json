{
  "name": "inbox-with-unread-notice",
  "argv": [
    "inbox"
  ],
  "env": {
    "CAPSTAN_TOKEN": "tok-0123456789abcdef0123456789abcdef",
    "CAPSTAN_SOCKET": "$ROOT/proj/.capstan/state/control.sock",
    "CAPSTAN_AGENT_ID": "developer-1",
    "TZ": "UTC"
  },
  "layout": {
    "dirs": [
      "proj/.capstan/state",
      "proj/sub/deeper"
    ],
    "files": [],
    "links": []
  },
  "cwd": "proj",
  "now": 1791374400000,
  "daemon": {
    "socket": "$ROOT/proj/.capstan/state/control.sock",
    "reply": {
      "kind": "line",
      "text": "{\"ok\":true,\"result\":{\"count\":1,\"messages\":[{\"messageId\":\"m-4\",\"state\":\"sent\",\"from\":\"pm-1\",\"fromAgentId\":\"pm-1\",\"body\":\"hi\"}],\"unread\":{\"count\":4,\"oldestQueuedAt\":\"2026-10-07T11:00:00Z\"}}}"
    }
  },
  "request": "{\"v\":1,\"credential\":\"tok-0123456789abcdef0123456789abcdef\",\"command\":\"inbox\",\"args\":[]}",
  "fallback": false,
  "node": {
    "stdout": "1 message(s) to act on; ack each one with cstan ack <message-id>\n\nmessage m-4 [sent] from pm-1\nhi\n",
    "stderr": "notice: 4 message(s) wait for you (oldest 60 min): run cstan inbox\n",
    "exit": 0
  }
}
