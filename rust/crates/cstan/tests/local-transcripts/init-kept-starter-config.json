      "text": "{\n  \"schemaVersion\": 1,\n  \"projectId\": \"<ID#1>\",\n  \"name\": \"proj\",\n  \"stateDirectory\": \"<ROOT>/proj/.capstan/state\",\n  \"maxSlices\": 4,\n  \"maxRunMs\": 3600000,\n  \"maxDispatches\": 16\n}\n"
