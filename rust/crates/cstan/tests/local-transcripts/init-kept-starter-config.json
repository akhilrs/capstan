  "cwd": "proj",
  "stdin": "",
  "tty": false,
  "now": 1791374400000,
  "before": [],
  "daemon": null,
  "stopAfter": null,
  "request": null,
  "node": {
    "stdout": "Kept existing capstan.toml\nInitialized Capstan project <ID#1>\nOperator credential: <ROOT>/proj/.capstan/operator.key (0600)\nAdd .capstan/ to .gitignore before staging project files.\n",
    "stderr": "warning: Capstan needs a git repository with at least one commit (workers get their own git worktree and branch from HEAD), but <ROOT>/proj is not inside a git work tree.\nFix: run in <ROOT>/proj:\n  git init\n  git add -A\n  git commit -m \"chore: initial commit\"\nor let Capstan do it: cstan init --git (it lists the files it will commit first)\n",
    "exit": 0,
    "signal": null
  },
